+    call op2d(b%RUNSFXY, 133, mode, "RUNSFXY")
+    call op2d(b%RUNSBXY, 134, mode, "RUNSBXY")
+    call op2d(b%ECANXY, 135, mode, "ECANXY")
+    call op2d(b%EDIRXY, 136, mode, "EDIRXY")
+    call op2d(b%ETRANXY, 137, mode, "ETRANXY")
+    call op2d(b%FSAXY, 138, mode, "FSAXY")
+    call op2d(b%RS, 139, mode, "RS")
+    call op2d(b%Z0, 140, mode, "Z0")
+    call op2d(b%ZNT, 141, mode, "ZNT")
+  end subroutine visit_diagnostics
+
+  subroutine hide_diagnostics(d)
+    character(*), intent(in) :: d
+    integer :: ncid, outid, vid, i, j, nvars, ndims, natts, xtype, rank, n
+    integer :: dims(3), shape(3), newvid, status
+    integer, allocatable :: varmap(:)
+    character(len=NF90_MAX_NAME) :: name
+    real(kind=kind_noahmp), allocatable :: data(:,:,:)
+    character(len=16), parameter :: names(*) = [character(len=16) :: &
+      "TERRAIN", "SHBXY", "EVBXY", "VEGFRA", &
+      "GVFMIN", "GVFMAX", "ALBSFCDIRXY", "ALBSFCDIFXY", &
+      "SAVXY", "SAGXY", "PAHXY", "FIRAXY", &
+      "HFX", "LH", "GHBXY", "CANHSXY", &
+      "TAU_EW", "TAU_NS", "T2MVXY", "T2MBXY", &
+      "Q2MVXY", "Q2MBXY", "TRADXY", "FVEGXY", &
+      "TGVXY", "TGBXY", "SHGXY", "SHCXY", &
+      "EVGXY", "EVCXY", "TRXY", "RUNSFXY", &
+      "RUNSBXY", "ECANXY", "EDIRXY", "ETRANXY", &
+      "FSAXY", "RS", "Z0", "ZNT"]
+    ! Copy only legacy variables. Renaming NetCDF-4 variables can fail in
+    ! HDF5 dimension-scale handling, independently of restart compatibility.
+    call ncchk(nf90_open(trim(d)//"/Level_0.nc", NF90_NOWRITE, ncid), "open checkpoint")
+    call ncchk(nf90_create(trim(d)//"/legacy.nc", IOR(NF90_CLOBBER, NF90_NETCDF4), outid), "create legacy")
+    call ncchk(nf90_inquire(ncid, nDimensions=ndims, nVariables=nvars, nAttributes=natts), "inquire")
+    do i = 1, ndims
+       call ncchk(nf90_inquire_dimension(ncid, i, name, n), "dimension")
+       call ncchk(nf90_def_dim(outid, trim(name), n, j), "define legacy dimension")
+    end do
+    do i = 1, natts
+       call ncchk(nf90_inq_attname(ncid, NF90_GLOBAL, i, name), "attribute name")
+       call ncchk(nf90_copy_att(ncid, NF90_GLOBAL, trim(name), outid, NF90_GLOBAL), "copy attribute")
+    end do
+    allocate(varmap(nvars))
+    varmap = 0
+    do vid = 1, nvars
+       call ncchk(nf90_inquire_variable(ncid, vid, name, xtype, rank), "variable")
+       if (any(names == trim(name))) cycle
+       if (rank < 2 .or. rank > 3) error stop "unexpected restart variable rank"
+       call ncchk(nf90_inquire_variable(ncid, vid, dimids=dims(:rank)), "variable dimensions")
+       call ncchk(nf90_def_var(outid, trim(name), xtype, dims(:rank), varmap(vid)), "legacy variable")
+    end do
+    call ncchk(nf90_enddef(outid), "enddef legacy")
+    do vid = 1, nvars
+       if (varmap(vid) == 0) cycle
+       call ncchk(nf90_inquire_variable(ncid, vid, ndims=rank), "variable rank")
+       call ncchk(nf90_inquire_variable(ncid, vid, dimids=dims(:rank)), "variable dimensions")
+       shape = 1
+       do i = 1, rank
+          call ncchk(nf90_inquire_dimension(ncid, dims(i), len=shape(i)), "dimension length")
+       end do
+       allocate(data(shape(1),shape(2),shape(3)))
+       if (rank == 2) then
+          call ncchk(nf90_get_var(ncid, vid, data(:,:,1)), "read legacy data")
+          call ncchk(nf90_put_var(outid, varmap(vid), data(:,:,1)), "write legacy data")
+       else
+          call ncchk(nf90_get_var(ncid, vid, data), "read legacy data")
+          call ncchk(nf90_put_var(outid, varmap(vid), data), "write legacy data")
+       end if
+       deallocate(data)
+    end do
+    call ncchk(nf90_close(ncid), "close original checkpoint")
+    call ncchk(nf90_close(outid), "close legacy checkpoint")
+    call execute_command_line("mv "//trim(d)//"/legacy.nc "//trim(d)//"/Level_0.nc", exitstat=status)
+    if (status /= 0) error stop "install legacy fixture failed"
+  end subroutine hide_diagnostics
