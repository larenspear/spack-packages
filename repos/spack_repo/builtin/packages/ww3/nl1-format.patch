The NL1 namelist diagnostic needs a comma between the real edit descriptor
and the following string literal. Without it, GNU Fortran aborts ww3_grid
while writing its configuration, before generating mod_def.ww3.

--- a/model/src/w3gridmd.F90
+++ b/model/src/w3gridmd.F90
@@ -6314,7 +6314,7 @@
 2922 FORMAT ( '  &SNL1 LAMBDA =',F7.3,', NLPROP =',E10.3,       &
          ', KDCONV =',F7.3,', KDMIN =',F7.3,','/           &
          '        SNLCS1 =',F7.3,', SNLCS2 =',F7.3,        &
-         ', SNLCS3 = ',F7.3','/                            &
+         ', SNLCS3 = ',F7.3,','/                           &
          '        IQTYPE =',I2,', TAILNL =',F5.1,','/      &
          '        GQMNF1 =',I2,', GQMNT1 =',I2,',',        &
          ' GQMNQ_OM2 =',I2,', GQMTHRSAT =',E11.4,', GQMTHRCOU =',F4.3,','/ &
